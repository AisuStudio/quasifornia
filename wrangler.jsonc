{
  "name": "quasifornia",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": { "bindings": [ { "name": "GRAF", "class_name": "GrafStore" }, { "name": "ROOM", "class_name": "Room" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": [ "GrafStore" ] }, { "tag": "v2", "new_sqlite_classes": [ "Room" ] } ],
  "assets": {
    "directory": "./prototype/kuesten-quest/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
